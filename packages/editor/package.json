{
	"name": "@rangex/editor",
	"version": "0.0.0",
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex-dev.git",
		"directory": "packages/editor"
	},
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"imports": {
		"#utilities": {
			"types": "./src/_Utilities/index.ts",
			"default": "./src/_Utilities/index"
		},
		"#adapters": {
			"types": "./src/Adapters/index.ts",
			"default": "./src/Adapters/index"
		},
		"#rangex-editor": {
			"types": "./src/RangeXEditor/index.ts",
			"default": "./src/RangeXEditor/index"
		},
		"#engine-links": {
			"types": "./src/EngineLinks/index.ts",
			"default": "./src/EngineLinks/index"
		},
		"#libs": {
			"types": "./src/Libs/index.ts",
			"default": "./src/Libs/index"
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"fix": "biome check ./src --write && tsc -p ./tsconfig.json",
		"pre:check": "biome check ./src && tsc && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@happy-dom/global-registrator": "^20.10.6",
		"@types/bun": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"rich-text-area": "workspace:*",
		"@shikijs/core": "^4.3.1",
		"@shikijs/engine-javascript": "^4.3.1",
		"@shikijs/langs": "^4.3.1",
		"@shikijs/themes": "^4.3.1",
		"shiki": "^4.0.2"
	}
}
