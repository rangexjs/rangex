{
	"name": "@rangex/rich-text-editor-ui",
	"version": "0.3.1-alpha.12",
	"private": false,
	"type": "module",
	"repository": "git@github.com:rangexjs/rich-text-editor-ui.git",
	"license": "MIT",
	"exports": {
		".": {
			"development": {
				"types": "./development/index.d.ts",
				"import": "./development/index.js"
			},
			"production": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p ./tsconfig.build.json",
		"fix": "biome check --write",
		"fix:unsafe": "biome check --write --unsafe",
		"lint": "biome check && tsc",
		"npm:publish": "biome check && tsc && vite build && npm publish"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"solid-js": "^1.9.11",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"typescript": "^6.0.3",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.10",
		"vite-tsconfig-paths": "^6.1.1"
	}
}
