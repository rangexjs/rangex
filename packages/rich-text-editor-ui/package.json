{
	"name": "@rangex/rich-text-editor-ui",
	"version": "0.3.1-alpha.12",
	"private": false,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex-dev.git",
		"directory": "packages/rich-text-editor-ui"
	},
	"license": "MIT",
	"exports": {
		".": {
			"development": {
				"types": "./development/index.d.ts",
				"import": "./development/index.js"
			},
			"production": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p ./tsconfig.build.json",
		"fix": "biome check --write",
		"fix:unsafe": "biome check --write --unsafe",
		"lint": "biome check && tsc",
		"npm:publish": "biome check && tsc && vite build && npm publish"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"solid-js": "^1.9.14",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-plugin-solid": "^2.11.12"
	}
}
