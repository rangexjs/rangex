{
	"name": "@rangex/syntax-highlighter-shiki",
	"version": "0.0.0",
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex.git",
		"directory": "packages/syntax-highlighter-shiki"
	},
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"import": "./src/index.ts"
			},
			"production": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"fix": "biome check ./src --write && tsc -p ./tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@rangex/editor": "workspace:*",
		"@types/bun": "^1.3.14",
		"esbuild": "^0.28.1",
		"shiki": "4.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	},
	"peerDependencies": {
		"@rangex/editor": "workspace:^",
		"shiki": "^4.3.1"
	}
}
