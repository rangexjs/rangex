{
  "name": "@rangex/rich-text-editor",
  "version": "1.0.0-beta.5",
  "description": "Zero-config RangeX rich text editor with extensions, toolbar and floating UI out of the box.",
  "keywords": [
    "contenteditable",
    "editor",
    "rangex",
    "rich-text-editor",
    "solid",
    "wysiwyg"
  ],
  "homepage": "https://github.com/rangexjs/rangex/tree/main/packages/rich-text-editor#readme",
  "bugs": "https://github.com/rangexjs/rangex/issues",
  "license": "MIT",
  "author": "Mozes Stumpf",
  "repository": {
    "type": "git",
    "url": "git@github.com:rangexjs/rangex.git",
    "directory": "packages/rich-text-editor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#utilities": {
      "@rangex/source": "./src/_Utilities/index.ts",
      "types": "./dist/_Utilities/index.d.ts"
    },
    "#color": {
      "@rangex/source": "./src/Color/index.ts",
      "types": "./dist/Color/index.d.ts"
    },
    "#constants": {
      "@rangex/source": "./src/Constants/index.ts",
      "types": "./dist/Constants/index.d.ts"
    },
    "#context": {
      "@rangex/source": "./src/Context/index.ts",
      "types": "./dist/Context/index.d.ts"
    },
    "#extensions": {
      "@rangex/source": "./src/Extensions/index.ts",
      "types": "./dist/Extensions/index.d.ts"
    },
    "#features": {
      "@rangex/source": "./src/Features/index.ts",
      "types": "./dist/Features/index.d.ts"
    },
    "#ui": {
      "@rangex/source": "./src/UI/index.ts",
      "types": "./dist/UI/index.d.ts"
    }
  },
  "exports": {
    ".": {
      "@rangex/source": "./src/Exports/index.ts",
      "types": "./dist/Exports/index.d.ts",
      "worker": "./dist/server/index.js",
      "browser": "./dist/index.js",
      "node": "./dist/server/index.js",
      "import": "./dist/index.js"
    },
    "./*": {
      "@rangex/source": "./src/Exports/*/index.ts",
      "types": "./dist/Exports/*/index.d.ts",
      "worker": "./dist/server/*.js",
      "browser": "./dist/*.js",
      "node": "./dist/server/*.js",
      "import": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -p ./tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "fix": "vp check --fix && tsc -p ./tsconfig.json",
    "pre:check": "vp check && tsc && vp test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/coverage-v8": "5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "peerDependencies": {
    "@rangex/editor": "1.0.0-beta.5",
    "@rangex/solid": "1.0.0-beta.5",
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "browserslist": [
    "chrome >= 159",
    "firefox >= 159",
    "safari >= 27.3"
  ]
}
