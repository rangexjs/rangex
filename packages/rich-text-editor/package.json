{
	"name": "@rangex/rich-text-editor",
	"version": "0.0.0",
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex.git",
		"directory": "packages/rich-text-editor"
	},
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"development": {
				"types": "./src/index.ts",
				"import": "./src/index.ts"
			},
			"production": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"imports": {
		"#utilities": {
			"types": {
				"development": "./src/_Utilities/index.ts",
				"production": "./dist/_Utilities/index.d.ts"
			},
			"default": "./src/_Utilities/index"
		},
		"#color": {
			"types": {
				"development": "./src/Color/index.ts",
				"production": "./dist/Color/index.d.ts"
			},
			"default": "./src/Color/index"
		},
		"#constants": {
			"types": {
				"development": "./src/Constants/index.ts",
				"production": "./dist/Constants/index.d.ts"
			},
			"default": "./src/Constants/index"
		},
		"#context": {
			"types": {
				"development": "./src/Context/index.ts",
				"production": "./dist/Context/index.d.ts"
			},
			"default": "./src/Context/index"
		},
		"#extensions": {
			"types": {
				"development": "./src/Extensions/index.ts",
				"production": "./dist/Extensions/index.d.ts"
			},
			"default": "./src/Extensions/index"
		},
		"#features": {
			"types": {
				"development": "./src/Features/index.ts",
				"production": "./dist/Features/index.d.ts"
			},
			"default": "./src/Features/index"
		},
		"#ui": {
			"types": {
				"development": "./src/UI/index.ts",
				"production": "./dist/UI/index.d.ts"
			},
			"default": "./src/UI/index"
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"fix": "biome check ./src --write && tsc -p ./tsconfig.json",
		"pre:check": "biome check ./src && tsc && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@happy-dom/global-registrator": "^20.10.6",
		"@rangex/editor": "workspace:*",
		"@rangex/solid": "workspace:*",
		"@solidjs/vite-plugin": "3.0.0-next.47",
		"@solidjs/web": "2.0.0-rc.13",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"solid-js": "2.0.0-rc.13",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@rangex/editor": "workspace:^",
		"@rangex/solid": "workspace:^",
		"@solidjs/web": "^2.0.0-rc.13",
		"solid-js": "^2.0.0-rc.13"
	}
}
