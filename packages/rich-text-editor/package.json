{
	"name": "@rangex/rich-text-editor",
	"version": "1.0.0-beta.0",
	"description": "Zero-config RangeX rich text editor with extensions, toolbar and floating UI out of the box.",
	"keywords": [
		"rangex",
		"rich-text-editor",
		"editor",
		"wysiwyg",
		"contenteditable",
		"solid"
	],
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex.git",
		"directory": "packages/rich-text-editor"
	},
	"homepage": "https://github.com/rangexjs/rangex/tree/main/packages/rich-text-editor#readme",
	"bugs": "https://github.com/rangexjs/rangex/issues",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
