{
	"name": "@rangex/rich-text-editor",
	"version": "0.0.0",
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex-dev.git",
		"directory": "packages/rich-text-editor"
	},
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"development": {
				"types": "./development/index.d.ts",
				"import": "./development/index.js"
			},
			"default": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"imports": {
		"#adapters": {
			"types": "./src/Adapters/index.ts",
			"default": "./src/Adapters/index"
		},
		"#editor": {
			"types": "./src/Editor/index.ts",
			"default": "./src/Editor/index"
		},
		"#ui": {
			"types": "./src/UI/index.ts",
			"default": "./src/UI/index"
		},
		"#ui-extensions": {
			"types": "./src/UI/Components/Extensions/index.ts",
			"default": "./src/UI/Components/Extensions/index"
		},
		"#ports": {
			"types": "./src/Ports/index.ts",
			"default": "./src/Ports/index"
		},
		"#editor-extensions": {
			"types": "./src/Editor/Extensions/index.ts",
			"default": "./src/Editor/Extensions/index"
		},
		"#libs": {
			"types": "./src/Libs/index.ts",
			"default": "./src/Libs/index"
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"biome:check": "biome check ./src",
		"fix": "biome check ./src --write",
		"lint": "biome check ./src && tsc -p ./tsconfig.json",
		"format": "biome format ./src",
		"format:write": "biome format --write ./src",
		"pre:check": "biome check ./src && tsc && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@happy-dom/global-registrator": "^20.10.6",
		"@types/bun": "^1.3.14",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-plugin-solid": "^2.11.12",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"shiki": "^4.0.2",
		"solid-js": "^1.9.14",
		"tailwindcss": "^4.3.3"
	}
}
