{
	"name": "@rangex/rich-text-editor",
	"version": "1.0.0-beta.0",
	"description": "Zero-config RangeX rich text editor with extensions, toolbar and floating UI out of the box.",
	"keywords": [
		"rangex",
		"rich-text-editor",
		"editor",
		"wysiwyg",
		"contenteditable",
		"solid"
	],
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex.git",
		"directory": "packages/rich-text-editor"
	},
	"homepage": "https://github.com/rangexjs/rangex/tree/main/packages/rich-text-editor#readme",
	"bugs": "https://github.com/rangexjs/rangex/issues",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@rangex/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"imports": {
		"#utilities": {
			"@rangex/source": "./src/_Utilities/index.ts",
			"types": "./dist/_Utilities/index.d.ts"
		},
		"#color": {
			"@rangex/source": "./src/Color/index.ts",
			"types": "./dist/Color/index.d.ts"
		},
		"#constants": {
			"@rangex/source": "./src/Constants/index.ts",
			"types": "./dist/Constants/index.d.ts"
		},
		"#context": {
			"@rangex/source": "./src/Context/index.ts",
			"types": "./dist/Context/index.d.ts"
		},
		"#extensions": {
			"@rangex/source": "./src/Extensions/index.ts",
			"types": "./dist/Extensions/index.d.ts"
		},
		"#features": {
			"@rangex/source": "./src/Features/index.ts",
			"types": "./dist/Features/index.d.ts"
		},
		"#ui": {
			"@rangex/source": "./src/UI/index.ts",
			"types": "./dist/UI/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"tag": "beta"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"prepublishOnly": "bun run build",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"fix": "biome check ./src ./package.json ./tsconfig*.json ./vite.config.ts --write && tsc -p ./tsconfig.json",
		"pre:check": "biome check ./src ./package.json ./tsconfig*.json ./vite.config.ts && tsc && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@happy-dom/global-registrator": "^20.10.6",
		"@rangex/editor": "workspace:*",
		"@rangex/solid": "workspace:*",
		"@solidjs/vite-plugin": "3.0.0-next.47",
		"@solidjs/web": "2.0.0-rc.13",
		"@tailwindcss/vite": "^4.3.3",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"solid-js": "2.0.0-rc.13",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@rangex/editor": "workspace:^",
		"@rangex/solid": "workspace:^",
		"@solidjs/web": "^2.0.0-rc.13",
		"solid-js": "^2.0.0-rc.13"
	}
}
