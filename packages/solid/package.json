{
	"name": "@rangex/solid",
	"version": "1.0.0-beta.0",
	"description": "SolidJS bindings for @rangex/editor: reactive ports and shared Solid utilities.",
	"keywords": [
		"rangex",
		"rich-text-editor",
		"editor",
		"wysiwyg",
		"contenteditable",
		"solid",
		"solidjs"
	],
	"author": "Mozes Stumpf <mozesstumpf@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git@github.com:rangexjs/rangex.git",
		"directory": "packages/solid"
	},
	"homepage": "https://github.com/rangexjs/rangex/tree/main/packages/solid#readme",
	"bugs": "https://github.com/rangexjs/rangex/issues",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@rangex/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"tag": "beta"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild dist/index.js --minify --outfile=dist/index.js --allow-overwrite && tsc -p ./tsconfig.build.json",
		"prepublishOnly": "bun run build",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"fix": "biome check ./src ./tsconfig*.json ./vite.config.ts --write && tsc -p ./tsconfig.json",
		"pre:check": "biome check ./src ./tsconfig*.json ./vite.config.ts && tsc && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@happy-dom/global-registrator": "^20.10.6",
		"@rangex/editor": "workspace:*",
		"@solidjs/vite-plugin": "3.0.0-next.47",
		"@solidjs/web": "2.0.0-rc.13",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"solid-js": "2.0.0-rc.13",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@rangex/editor": "workspace:^",
		"@solidjs/web": "^2.0.0-rc.13",
		"solid-js": "^2.0.0-rc.13"
	}
}
