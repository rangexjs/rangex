{
  "name": "@rangex/solid",
  "version": "1.0.0-beta.1",
  "description": "SolidJS bindings for @rangex/editor: reactive ports and shared Solid utilities.",
  "keywords": [
    "contenteditable",
    "editor",
    "rangex",
    "rich-text-editor",
    "solid",
    "solidjs",
    "wysiwyg"
  ],
  "homepage": "https://github.com/rangexjs/rangex/tree/main/packages/solid#readme",
  "bugs": "https://github.com/rangexjs/rangex/issues",
  "license": "MIT",
  "author": "Mozes Stumpf",
  "repository": {
    "type": "git",
    "url": "git@github.com:rangexjs/rangex.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rangex/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc -p ./tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "fix": "vp check --fix && tsc -p ./tsconfig.json",
    "pre:check": "vp check && tsc && vp test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "peerDependencies": {
    "@rangex/editor": "1.0.0-beta.1",
    "@solidjs/web": "^2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.13"
  },
  "browserslist": [
    "chrome >= 159",
    "firefox >= 159",
    "safari >= 27.3"
  ]
}
