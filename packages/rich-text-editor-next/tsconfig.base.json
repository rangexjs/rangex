{
	"compilerOptions": {
		"target": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"newLine": "lf",
		"esModuleInterop": true,
		"module": "esnext",
		"skipLibCheck": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"lib": ["dom", "dom.iterable", "esnext"],
		"resolveJsonModule": true,
		"isolatedModules": true
	}
}
